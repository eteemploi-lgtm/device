// ============================================================
// FONCTION GENERIQUE DE RECUPERATION JSON
// ============================================================

function fetchJson(url) {

    return fetch(url)
        .then(response => {

            if (!response.ok) {
                throw new Error(
                    `Erreur HTTP ${response.status} sur ${url}`
                );
            }

            return response.json();
        });
}


// ============================================================
// ============================================================
// 1. BATTERIES
// ============================================================
// ============================================================

function getBatteries() {

    fetchJson("/batteries")

        .then(data => {

            console.log(
                "[HTTP] JSON BATTERIES reçu :",
                data
            );

            traiterBatteries(data);
        })

        .catch(error => {

            console.error(
                "[HTTP] Erreur batteries :",
                error
            );
        });
}


// ------------------------------------------------------------
// TRAITEMENT BATTERIES
// ------------------------------------------------------------

function traiterBatteries(data) {

    if (!data) {
        console.warn("[BATTERIES] JSON vide");
        return;
    }


    /*
        Ton JSON ressemble à :

        {
            "type": "state",
            "batterie": {
                ...
            }
        }
    */


    if (data.batterie) {

        console.log(
            "[BATTERIES] batterie :",
            data.batterie
        );


        // Fonction déjà présente dans ton projet
        if (typeof renderBattery === "function") {

            renderBattery(
                data.batterie
            );
        }

        else {

            console.warn(
                "[BATTERIES] renderBattery() introuvable"
            );
        }
    }

    else {

        console.warn(
            "[BATTERIES] propriété 'batterie' absente",
            data
        );
    }
}


