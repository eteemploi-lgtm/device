    getBatteries();

    getSta();

    getEtatDevice();
}


// ============================================================
// ============================================================
// DEMARRAGE
// ============================================================
// ============================================================

function demarrerReceptionHttp() {

    console.log(
        "[HTTP] Démarrage réception backend"
    );


    // --------------------------------------------------------
    // Configuration :
    // une fois au démarrage
    // --------------------------------------------------------

    getConfigurationDef();


    // --------------------------------------------------------
    // Etat dynamique :
    // immédiatement au démarrage
    // --------------------------------------------------------

    actualiserDonneesBackend();


    // --------------------------------------------------------
    // Puis actualisation toutes les 1000 ms
    // --------------------------------------------------------

    setInterval(
        actualiserDonneesBackend,
        1000
    );
}


// ============================================================
// ATTENDRE QUE LA PAGE HTML SOIT CHARGEE
// ============================================================

if (document.readyState === "loading") {

    document.addEventListener(
        "DOMContentLoaded",
        demarrerReceptionHttp
    );
}

else {

    demarrerReceptionHttp();
}
