// ------------------------------------------------------------
// TRAITEMENT STA
// ------------------------------------------------------------

function traiterSta(data) {

    if (!data) {

        console.warn(
            "[STA] JSON vide"
        );

        return;
    }


    /*
        D'après ton JSON :

        {
            "ReponseSta": {
                "dCmdNum_Mess": 0,
                "dCmdIdent": "0",
                ...
            }
        }
    */


    if (data.ReponseSta) {

        console.log(
            "[STA] ReponseSta :",
            data.ReponseSta
        );


        /*
            ATTENTION :

            Ici je pars du principe que renderSta()
            peut recevoir directement ReponseSta.

            Si ton ancienne fonction attendait une autre
            structure, c'est cette ligne qu'on modifiera.
        */

        if (typeof renderSta === "function") {

            renderSta(
                data.ReponseSta
            );
        }

        else {

            console.warn(
                "[STA] renderSta() introuvable"
            );
        }
    }

    else {

        console.warn(
            "[STA] propriété 'ReponseSta' absente",
            data
        );
    }
}


