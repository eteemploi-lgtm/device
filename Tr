// ------------------------------------------------------------
// TRAITEMENT ETAT DEVICE
// ------------------------------------------------------------

function traiterEtatDevice(data) {

    if (!data) {

        console.warn(
            "[ETAT DEVICE] JSON vide"
        );

        return;
    }


    /*
        Ton JSON contient notamment :

        {
            "type": "state",

            "apercu": {...},

            "motor": {...},

            "STA": {...},

            "Imu": {...},

            "sensors": {...},

            "gouverne": {...}
        }
    */


    // --------------------------------------------------------
    // MOTOR
    // --------------------------------------------------------

    if (
        data.motor &&
        typeof renderMotor === "function"
    ) {

        renderMotor(
            data.motor
        );
    }


    // --------------------------------------------------------
    // SENSORS
    // --------------------------------------------------------

    if (
        data.sensors &&
        typeof renderSensors === "function"
    ) {

        renderSensors(
            data.sensors
        );
    }


    // --------------------------------------------------------
    // IMU
    // --------------------------------------------------------

    if (
        data.Imu &&
        typeof renderImu === "function"
    ) {

        renderImu(
            data.Imu
        );
    }


    // --------------------------------------------------------
    // GOUVERNE
    // --------------------------------------------------------

    if (
        data.gouverne &&
        typeof renderGouv === "function"
    ) {

        renderGouv(
            data.gouverne
        );
    }


    /*
        Si ton EtatDevice contient également STA
        et que tu veux l'afficher :
    */

    if (
        data.STA &&
        typeof renderSta === "function"
    ) {

        renderSta(
            data.STA
        );
    }


    // --------------------------------------------------------
    // STATUS / APERCU
    // --------------------------------------------------------

    /*
        Ton nouveau JSON semble utiliser "apercu".

        Si les informations précédemment contenues dans
        data.Status sont maintenant dans data.apercu,
        on les traite ici.
    */


    if (data.apercu) {

        const status =
            data.apercu;


        console.log(
            "[ETAT DEVICE] Apercu :",
            status
        );


        /*
            On conserve tes anciens appels
            updateDeviceStatus() lorsqu'une valeur existe.
        */


        if (
            status.PhaseLVA !== undefined &&
            typeof updateDeviceStatus === "function"
        ) {

            updateDeviceStatus(
                "dashPhaseLVALed",
                "dashPhaseLVAText",
                status.PhaseLVA
            );
        }


        if (
            status.EtatComLVA !== undefined &&
            typeof updateDeviceStatus === "function"
        ) {

            updateDeviceStatus(
                "dashEtatComLVALed",
                "dashEtatComLVAText",
                status.EtatComLVA
            );
        }


        if (
            status.Carte_convertisseur_etat_shutdown !== undefined &&
            typeof updateDeviceStatus === "function"
        ) {

            updateDeviceStatus(
                "dashShutdown",
                "dashShutdownText",
                status.Carte_convertisseur_etat_shutdown
            );
        }


        if (
            status.Carte_interface_etat_shutdown !== undefined &&
            typeof updateDeviceStatus === "function"
        ) {

            updateDeviceStatus(
                "dashInterfaceShutdown",
                "dashInterfaceShutdownText",
                status.Carte_interface_etat_shutdown
            );
        }


        if (
            status.Etat_240V !== undefined &&
            typeof updateDeviceStatus === "function"
        ) {

            updateDeviceStatus(
                "dashEtat_240VLed",
                "dashEtat_240VText",
                status.Etat_240V
            );
        }


        if (
            status.Etat_480Von !== undefined &&
            typeof updateDeviceStatus === "function"
        ) {

            updateDeviceStatus(
                "dashEtat_480VLed",
                "dashEtat_480VText",
                status.Etat_480Von
            );
        }


        if (
            status.Etat_magic !== undefined &&
            typeof updateDeviceStatus === "function"
        ) {

            updateDeviceStatus(
                "dashEtat_magicLed",
                "dashEtat_magicText",
                status.Etat_magic
            );
        }


        if (
            status.Etat_torp_out !== undefined &&
            typeof updateDeviceStatus === "function"
        ) {

            updateDeviceStatus(
                "dashEtat_torp_outLed",
                "dashEtat_torp_outText",
                status.Etat_torp_out
            );
        }


        if (
            status.Etat_contacteurs !== undefined &&
            typeof updateDeviceStatus === "function"
        ) {

            updateDeviceStatus(
                "dashEtat_contacteurs",
                "dashEtat_contacteursText",
                status.Etat_contacteurs
            );
        }
    }


    console.log(
        "[ETAT DEVICE] traitement terminé"
    );
}


