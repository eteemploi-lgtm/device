// ------------------------------------------------------------
// TRAITEMENT CONFIGURATION DEF
// ------------------------------------------------------------

function traiterConfigurationDef(data) {

    if (!data) {

        console.warn(
            "[CONFIG] JSON vide"
        );

        return;
    }


    /*
        Ton JSON :

        {
            "ConfigurationDef": {
                "uiTypeTir": 3,
                "cFileMission": "...",
                ...
            }
        }
    */


    if (!data.ConfigurationDef) {

        console.warn(
            "[CONFIG] ConfigurationDef absente",
            data
        );

        return;
    }


    const config =
        data.ConfigurationDef;


    console.log(
        "[CONFIG] Configuration chargée :",
        config
    );


    // --------------------------------------------------------
    // Réutilisation de ta fonction existante
    // --------------------------------------------------------

    if (
        typeof validateAndFillConfig === "function"
    ) {

        const result =
            validateAndFillConfig(
                config
            );


        console.log(
            "[CONFIG] Résultat :",
            result
        );


        // ----------------------------------------------------
        // LOG
        // ----------------------------------------------------

        if (
            typeof addLog === "function" &&
            result
        ) {

            addLog(

                `Configuration chargée : ` +
                `${result.validCount} champ(s) valide(s), ` +
                `${result.errorCount} erreur(s)`,

                result.errorCount > 0
                    ? "warn"
                    : "info"
            );
        }


        // ----------------------------------------------------
        // FEEDBACK VISUEL
        // ----------------------------------------------------

        const feedback =
            document.getElementById(
                "configTirFeedback"
            );


        if (
            feedback &&
            result
        ) {

            feedback.textContent =
                `✓ Configuration chargée ` +
                `(${result.validCount} champs)`;


            setTimeout(
                () => {

                    feedback.textContent = "";

                },
                3000
            );
        }
    }

    else {

        console.warn(
            "[CONFIG] validateAndFillConfig() introuvable"
        );
    }
}


// ============================================================
// ============================================================
// RECUPERATION DES DONNEES DYNAMIQUES
// ============================================================
// ============================================================

function actualiserDonneesBackend() {

    getBatteries();

    getSta();

    getEtatDevice();
}


// ============================================================
// ============================================================
// DEMARRAGE
// ============================================================
// ============================================================

function demarrerReceptionHttp() {

    console.log(
        "[HTTP] Démarrage réception backend"
    );


    // --------------------------------------------------------
    // Configuration :
    // une fois au démarrage
    // --------------------------------------------------------

    getConfigurationDef();


    // --------------------------------------------------------
    // Etat dynamique :
    // immédiatement au démarrage
    // --------------------------------------------------------

    actualiserDonneesBackend();


    // --------------------------------------------------------
    // Puis actualisation toutes les 1000 ms
    // --------------------------------------------------------

    setInterval(
        actualiserDonneesBackend,
        1000
    );
}


// ============================================================
// ATTENDRE QUE LA PAGE HTML SOIT CHARGEE
// ============================================================

if (document.readyState === "loading") {

    document.addEventListener(
        "DOMContentLoaded",
        demarrerReceptionHttp
    );
}

else {

    demarrerReceptionHttp();
}
