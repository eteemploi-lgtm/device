// TRAITEMENT BATTERIES
// ============================================================
// ============================================================

function traiterBatteries(data) {

    console.log(
        "[SIMULATION] BATTERIES :",
        data
    );


    if (
        data &&
        data.batterie &&
        typeof renderBattery === "function"
    ) {

        renderBattery(
            data.batterie
        );
    }
}


// ============================================================
// ============================================================
// TRAITEMENT STA
// ============================================================
// ============================================================

function traiterSta(data) {

    console.log(
        "[SIMULATION] STA :",
        data
    );


    if (
        data &&
        data.ReponseSta &&
        typeof renderSta === "function"
    ) {

        renderSta(
            data.ReponseSta
        );
    }
}


// ============================================================
// ============================================================
// TRAITEMENT ETAT DEVICE
// ============================================================
// ============================================================

function traiterEtatDevice(data) {

    console.log(
        "[SIMULATION] ETAT DEVICE :",
        data
    );


    if (!data) {
        return;
    }


    // --------------------------------------------------------
    // MOTOR
    // --------------------------------------------------------

    if (
        data.motor &&
        typeof renderMotor === "function"
    ) {

        renderMotor(
            data.motor
        );
    }


    // --------------------------------------------------------
    // SENSORS
    // --------------------------------------------------------

    if (
        data.sensors &&
        typeof renderSensors === "function"
    ) {

        renderSensors(
            data.sensors
        );
    }


    // --------------------------------------------------------
    // IMU
    // --------------------------------------------------------

    if (
        data.Imu &&
        typeof renderImu === "function"
    ) {

        renderImu(
            data.Imu
        );
    }


    // --------------------------------------------------------
    // GOUVERNE
    // --------------------------------------------------------

    if (
        data.gouverne &&
        typeof renderGouv === "function"
    ) {

        renderGouv(
            data.gouverne
        );
    }


    // --------------------------------------------------------
    // STA présent dans EtatDevice
    // --------------------------------------------------------

    if (
        data.STA &&
        typeof renderSta === "function"
    ) {

        renderSta(
            data.STA
        );
    }


    // --------------------------------------------------------
    // APERCU
    // --------------------------------------------------------

    if (data.apercu) {

        console.log(
            "[SIMULATION] APERCU :",
            data.apercu
        );
    }
}


// ============================================================
// ============================================================
// TRAITEMENT CONFIGURATION
// ============================================================
// ============================================================

function traiterConfigurationDef(data) {

    console.log(
        "[SIMULATION] CONFIGURATION DEF :",
        data
    );


    if (
        !data ||
        !data.ConfigurationDef
    ) {

        return;
    }


    const config =
        data.ConfigurationDef;


    if (
        typeof validateAndFillConfig
        === "function"
    ) {

        const result =
            validateAndFillConfig(
                config
            );


        console.log(
            "[SIMULATION CONFIG] résultat :",
            result
        );


        if (
            typeof addLog === "function" &&
            result
        ) {

            addLog(

                `Configuration simulation chargée : ` +
                `${result.validCount} champ(s) valide(s), ` +
                `${result.errorCount} erreur(s)`,

                result.errorCount > 0
                    ? "warn"
                    : "info"
            );
        }
    }
}


// ============================================================
// ============================================================
// GENERATION DE VALEURS DYNAMIQUES
// ============================================================
// ============================================================

function mettreAJourSimulation() {


    // ========================================================
    // MOTOR
    // ========================================================

    simulationEtatDevice.motor.rpm_actual =
        Math.round(
            1200 +
            Math.random() * 300
        );


    simulationEtatDevice.motor.temperature =
        Number(
            (
                40 +
                Math.random() * 5
            ).toFixed(1)
        );


    // ========================================================
    // IMU
    // ========================================================

    simulationEtatDevice.Imu.vitesse_lineaire =
        Number(
            (
                2 +
                Math.random()
            ).toFixed(2)
        );


    simulationEtatDevice.Imu.assiette =
        Number(
            (
                -3 +
                Math.random() * 6
            ).toFixed(2)
        );


    simulationEtatDevice.Imu.immersion =
        Number(
            (
                0.70 +
                Math.random() * 0.15
            ).toFixed(2)
        );


    // ========================================================
    // CAPTEURS
    // ========================================================

    simulationEtatDevice.sensors.pressure =
        Number(
            (
                1.20 +
                Math.random() * 0.10
            ).toFixed(2)
        );


    simulationEtatDevice.sensors.temp_smo1 =
        Number(
            (
                22 +
                Math.random() * 2
            ).toFixed(1)
        );


    simulationEtatDevice.sensors.temp_smo2 =
        Number(
            (
                22 +
                Math.random() * 2
            ).toFixed(1)
        );


    simulationEtatDevice.sensors.temp_smo3 =
        Number(
            (
                22 +
                Math.random() * 2
            ).toFixed(1)
        );


    // ========================================================
    // GOUVERNE
    // ========================================================

    simulationEtatDevice.gouverne.sup.position_mes =
        Number(
            (
                simulationEtatDevice.gouverne.sup.position_Cmd +
                (Math.random() - 0.5) * 0.02
            ).toFixed(4)
        );


    // ========================================================
    // BATTERIE
    // ========================================================

    simulationBatterie.batterie.etat.tension =
        Number(
            (
                24.4 +
                Math.random() * 0.4
            ).toFixed(2)
        );


    simulationBatterie.batterie.etat.courant =
        Number(
            (
                10 +
                Math.random() * 5
            ).toFixed(2)
        );


    // ========================================================
    // STA
    // ========================================================

    simulationSta.ReponseSta.dCmdNum_Seq++;

    simulationSta.ReponseSta.dAckNum_Seq =
        simulationSta.ReponseSta.dCmdNum_Seq;
}


// ============================================================
// ============================================================
// ACTUALISATION DE L'IHM
// ============================================================
// ============================================================

function actualiserSimulation() {


    // --------------------------------------------------------
    // Faire évoluer les données
    // --------------------------------------------------------

    mettreAJourSimulation();


    // --------------------------------------------------------
    // Envoyer les données aux fonctions de l'IHM
    // --------------------------------------------------------

    traiterBatteries(
        simulationBatterie
    );


    traiterSta(
        simulationSta
    );


    traiterEtatDevice(
        simulationEtatDevice
    );
}


// ============================================================
// ============================================================
// DEMARRAGE DU MODE SIMULATION
// ============================================================
// ============================================================

function demarrerSimulation() {

    if (!MODE_SIMULATION) {
        return;
    }


    console.log(
        "========================================"
    );

    console.log(
        "MODE SIMULATION BACKEND ACTIF"
    );

    console.log(
        "========================================"
    );


    // --------------------------------------------------------
    // Configuration envoyée une seule fois
    // --------------------------------------------------------

    traiterConfigurationDef(
        simulationConfigurationDef
    );


    // --------------------------------------------------------
    // Premier état immédiatement
    // --------------------------------------------------------

    actualiserSimulation();


    // --------------------------------------------------------
    // Nouvel état chaque seconde
    // --------------------------------------------------------

    setInterval(
        actualiserSimulation,
        1000
    );
}


// ============================================================
// ============================================================
// LANCEMENT
// ============================================================
// ============================================================

if (document.readyState === "loading") {

    document.addEventListener(
        "DOMContentLoaded",
        demarrerSimulation
    );
}

else {

    demarrerSimulation();
}
