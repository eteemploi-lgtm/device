// ============================================================
// ============================================================
// MAIN
// ============================================================
// ============================================================

int main(void)
{
    int server_fd;


    // ========================================================
    // CREATION SOCKET
    // ========================================================

    server_fd = socket(
        AF_INET,
        SOCK_STREAM,
        0
    );


    if (server_fd < 0)
    {
        perror("socket");
        return 1;
    }


    // ========================================================
    // REUTILISATION DU PORT
    // ========================================================

    int opt = 1;


    setsockopt(
        server_fd,
        SOL_SOCKET,
        SO_REUSEADDR,
        &opt,
        sizeof(opt)
    );


    // ========================================================
    // ADRESSE
    // ========================================================

    struct sockaddr_in adresse;


    memset(
        &adresse,
        0,
        sizeof(adresse)
    );


    adresse.sin_family = AF_INET;

    adresse.sin_addr.s_addr = INADDR_ANY;

    adresse.sin_port = htons(PORT);


    // ========================================================
    // BIND
    // ========================================================

    if (
        bind(
            server_fd,
            (struct sockaddr *)&adresse,
            sizeof(adresse)
        ) < 0
    )
    {
        perror("bind");

        close(server_fd);

        return 1;
    }


    // ========================================================
    // LISTEN
    // ========================================================

    if (
        listen(
            server_fd,
            10
        ) < 0
    )
    {
        perror("listen");

        close(server_fd);

        return 1;
    }


    printf(
        "\n"
        "========================================\n"
        " SERVEUR C ACTIF\n"
        " Port : %d\n"
        "========================================\n\n",
        PORT
    );


    // ========================================================
    // BOUCLE SERVEUR
    // ========================================================

    while (1)
    {
        int client_fd = accept(
            server_fd,
            NULL,
            NULL
        );


        if (client_fd < 0)
        {
            perror("accept");

            continue;
        }


        char request[BUFFER_SIZE];


        memset(
            request,
            0,
            sizeof(request)
        );


        ssize_t recu = recv(
            client_fd,
            request,
            sizeof(request) - 1,
            0
        );


        if (recu <= 0)
        {
            close(client_fd);

            continue;
        }


        request[recu] = '\0';


        // ====================================================
        // AFFICHAGE DE LA REQUETE
        // ====================================================

        char methode[16] = {0};

        char route[256] = {0};


        sscanf(
            request,
            "%15s %255s",
            methode,
            route
        );


        printf(
            "HTTP : %s %s\n",
            methode,
            route
        );


        // ====================================================
        // OPTIONS
        // ====================================================

        if (
            strcmp(
                methode,
                "OPTIONS"
            ) == 0
        )
        {
            envoyer_headers(
                client_fd,
                "204 No Content",
                "text/plain",
                0
            );
        }


        // ====================================================
        // JSON BATTERIES
        // ====================================================

        else if (
            strcmp(methode, "GET") == 0 &&
            strcmp(route, "/batteries") == 0
        )
        {
            envoyer_batteries(
                client_fd
            );
        }


        // ====================================================
        // JSON STA
        // ====================================================

        else if (
            strcmp(methode, "GET") == 0 &&
            strcmp(route, "/sta") == 0
        )
        {
            envoyer_sta(
                client_fd
            );
        }


        // ====================================================
        // JSON ETAT DEVICE
        // ====================================================

        else if (
            strcmp(methode, "GET") == 0 &&
            strcmp(route, "/etatdevice") == 0
        )
        {
            envoyer_etat_device(
                client_fd
            );
        }


        // ====================================================
        // JSON CONFIGURATION DEF
        // ====================================================

        else if (
            strcmp(methode, "GET") == 0 &&
            strcmp(route, "/configdef") == 0
        )
        {
            envoyer_config_def(
                client_fd
            );
        }


        // ====================================================
        // SCRIPT JS
        // ====================================================

        else if (
            strcmp(route, "/script.js") == 0
        )
        {
            envoyer_fichier(
                client_fd,
                BASE_PATH "/script.js",
                "application/javascript"
            );
        }


        // ====================================================
        // STYLE.CSS
        // ====================================================

        else if (
            strcmp(route, "/style.css") == 0
        )
        {
            envoyer_fichier(
                client_fd,
                BASE_PATH "/style.css",
                "text/css"
            );
        }


        // ====================================================
        // STYLE2.CSS
        // ====================================================

        else if (
            strcmp(route, "/style2.css") == 0
        )
        {
            envoyer_fichier(
                client_fd,
                BASE_PATH "/style2.css",
                "text/css"
            );
        }


        // ====================================================
        // PAGE PRINCIPALE
        // ====================================================

        else if (
            strcmp(route, "/") == 0 ||
            strcmp(route, "/index.html") == 0
        )
        {
            envoyer_fichier(
                client_fd,
                BASE_PATH "/index.html",
                "text/html"
            );
        }


        // ====================================================
        // 404
        // ====================================================

        else
        {
            const char *erreur =
                "404 - Route introuvable";


            envoyer_headers(
                client_fd,
                "404 Not Found",
                "text/plain",
                strlen(erreur)
            );


            envoyer_tout(
                client_fd,
                erreur,
                strlen(erreur)
            );
        }


        close(
            client_fd
        );
    }


    close(
        server_fd
    );


    return 0;
}
