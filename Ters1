// ============================================================

// ============================================================

// MAIN

// ============================================================

// ============================================================

int main(void)

{

    // ========================================================

    // CREATION SOCKET HTTP

    // ========================================================

    int server_fd = socket(

        AF_INET,

        SOCK_STREAM,

        0

    );

    if (server_fd < 0)

    {

        perror("socket");

        return 1;

    }

    // ========================================================

    // REUTILISATION DU PORT

    // ========================================================

    int opt = 1;

    if (

        setsockopt(

            server_fd,

            SOL_SOCKET,

            SO_REUSEADDR,

            &opt,

            sizeof(opt)

        ) < 0

    )

    {

        perror("setsockopt");

    }

    // ========================================================

    // ADRESSE SERVEUR

    // ========================================================

    struct sockaddr_in adresse;

    memset(

        &adresse,

        0,

        sizeof(adresse)

    );

    adresse.sin_family = AF_INET;

    adresse.sin_addr.s_addr =

        INADDR_ANY;

    adresse.sin_port =

        htons(PORT);

    // ========================================================

    // BIND

    // ========================================================

    if (

        bind(

            server_fd,

            (struct sockaddr *)&adresse,

            sizeof(adresse)

        ) < 0

    )

    {

        perror("bind");

        close(server_fd);

        return 1;

    }

    // ========================================================

    // LISTEN

    // ========================================================

    if (

        listen(

            server_fd,

            10

        ) < 0

    )

    {

        perror("listen");

        close(server_fd);

        return 1;

    }

    // ========================================================

    // INFORMATION

    // ========================================================

    printf("\n");

    printf(

        "====================================================\n"

    );

    printf(

        " SERVEUR C ACTIF\n"

    );

    printf(

        " Port : %d\n",

        PORT

    );

    printf(

        "====================================================\n"

    );

    printf(

        " GET  /batteries\n"

    );

    printf(

        " GET  /sta\n"

    );

    printf(

        " GET  /etatdevice\n"

    );

    printf(

        " GET  /configdef\n"

    );

    printf(

        " POST /message   <- FRONT VERS BACK\n"

    );

    printf(

        "====================================================\n\n"

    );

    // ========================================================

    // BOUCLE PRINCIPALE

    // ========================================================

    while (1)

    {

        // ====================================================

        // ATTENTE CLIENT

        // ====================================================

        int client_fd = accept(

            server_fd,

            NULL,

            NULL

        );

        if (client_fd < 0)

        {

            perror("accept");

            continue;

        }

        // ====================================================

        // BUFFER REQUETE

        // ====================================================

        char request[

            REQUEST_BUFFER_SIZE

        ];

        memset(

            request,

            0,

            sizeof(request)

        );

        // ====================================================

        // RECEPTION COMPLETE

        // ====================================================

        ssize_t recu =

            recevoir_requete_http(

                client_fd,

                request,

                sizeof(request)

            );

        if (recu <= 0)

        {

            close(

                client_fd

            );

            continue;

        }

        // ====================================================

        // EXTRACTION METHODE + ROUTE

        // ====================================================

        char methode[16] = {0};

        char route[256] = {0};

        if (

            sscanf(

                request,

                "%15s %255s",

                methode,

                route

            ) != 2

        )

        {

            envoyer_erreur_json(

                client_fd,

                "400 Bad Request",

                "Requete HTTP invalide"

            );

            close(

                client_fd

            );

            continue;

        }

        printf(

            "HTTP : %s %s\n",

            methode,

            route

        );

        // ====================================================

        // OPTIONS

        // ====================================================

        if (

            strcmp(

                methode,

                "OPTIONS"

            ) == 0

        )

        {

            envoyer_headers(

                client_fd,

                "204 No Content",

                "text/plain",

                0

            );

        }

        // ====================================================

        // FRONT -> BACK

        //

        // POST /message

        // ====================================================

        else if (

            strcmp(

                methode,

                "POST"

            ) == 0

            &&

            strcmp(

                route,

                "/message"

            ) == 0

        )

        {

            recevoir_message_front(

                client_fd,

                request

            );

        }

        // ====================================================

        // BACK -> FRONT

        //

        // BATTERIES

        // ====================================================

        else if (

            strcmp(

                methode,

                "GET"

            ) == 0

            &&

            strcmp(

                route,

                "/batteries"

            ) == 0

        )

        {

            envoyer_batteries(

                client_fd

            );

        }

        // ====================================================

        // BACK -> FRONT

        //

        // STA

        // ====================================================

        else if (

            strcmp(

                methode,

                "GET"

            ) == 0

            &&

            strcmp(

                route,

                "/sta"

            ) == 0

        )

        {

            envoyer_sta(

                client_fd

            );

        }

        // ====================================================

        // BACK -> FRONT

        //

        // ETAT DEVICE

        // ====================================================

        else if (

            strcmp(

                methode,

                "GET"

            ) == 0

            &&

            strcmp(

                route,

                "/etatdevice"

            ) == 0

        )

        {

            envoyer_etat_device(

                client_fd

            );

        }

        // ====================================================

        // BACK -> FRONT

        //

        // CONFIGURATION DEF

        // ====================================================

        else if (

            strcmp(

                methode,

                "GET"

            ) == 0

            &&

            strcmp(

                route,

                "/configdef"

            ) == 0

        )

        {

            envoyer_config_def(

                client_fd

            );

        }

        // ====================================================

        // INDEX.HTML

        // ====================================================

        else if (

            strcmp(

                methode,

                "GET"

            ) == 0

            &&

            (

                strcmp(

                    route,

                    "/"

                ) == 0

                ||

                strcmp(

                    route,

                    "/index.html"

                ) == 0

            )

        )

        {

            envoyer_fichier(

                client_fd,

                BASE_PATH "/index.html",

                "text/html; charset=utf-8"

            );

        }

        // ====================================================

        // SCRIPT.JS

        // ====================================================

        else if (

            strcmp(

                methode,

                "GET"

            ) == 0

            &&

            strcmp(

                route,

                "/script.js"

            ) == 0

        )

        {

            envoyer_fichier(

                client_fd,

                BASE_PATH "/script.js",

                "application/javascript; charset=utf-8"

            );

        }

        // ====================================================

        // STYLE.CSS

        // ====================================================

        else if (

            strcmp(

                methode,

                "GET"

            ) == 0

            &&

            strcmp(

                route,

                "/style.css"

            ) == 0

        )

        {

            envoyer_fichier(

                client_fd,

                BASE_PATH "/style.css",

                "text/css; charset=utf-8"

            );

        }

        // ====================================================

        // STYLE2.CSS

        // ====================================================

        else if (

            strcmp(

                methode,

                "GET"

            ) == 0

            &&

            strcmp(

                route,

                "/style2.css"

            ) == 0

        )

        {

            envoyer_fichier(

                client_fd,

                BASE_PATH "/style2.css",

                "text/css; charset=utf-8"

            );

        }

        // ====================================================

        // FAVICON

        // ====================================================

        else if (

            strcmp(

                route,

                "/favicon.ico"

            ) == 0

        )

        {

            envoyer_headers(

                client_fd,

                "204 No Content",

                "image/x-icon",

                0

            );

        }

        // ====================================================

        // ROUTE INCONNUE

        // ====================================================

        else

        {

            printf(

                "[404] Route inconnue : %s\n",

                route

            );

            envoyer_erreur_json(

                client_fd,

                "404 Not Found",

                "Route introuvable"

            );

        }

        // ====================================================

        // FIN CLIENT

        // ====================================================

        close(

            client_fd

        );

    }

    // Normalement jamais atteint

    close(

        server_fd

    );

    return 0;

}
