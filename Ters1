// ============================================================
// ENVOYER TOUTES LES DONNEES
// ============================================================

int envoyer_tout(
    int socket_fd,
    const char *buffer,
    size_t longueur
)
{
    size_t total = 0;

    while (total < longueur)
    {
        ssize_t envoye = send(
            socket_fd,
            buffer + total,
            longueur - total,
            0
        );

        if (envoye <= 0)
        {
            return -1;
        }

        total += (size_t)envoye;
    }

    return 0;
}


// ============================================================
// HEADERS HTTP
// ============================================================

void envoyer_headers(
    int client_fd,
    const char *status,
    const char *content_type,
    size_t content_length
)
{
    char header[1024];

    int taille = snprintf(
        header,
        sizeof(header),

        "HTTP/1.1 %s\r\n"
        "Content-Type: %s\r\n"
        "Access-Control-Allow-Origin: *\r\n"
        "Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n"
        "Access-Control-Allow-Headers: Content-Type\r\n"
        "Content-Length: %zu\r\n"
        "Connection: close\r\n"
        "\r\n",

        status,
        content_type,
        content_length
    );

    if (taille > 0)
    {
        envoyer_tout(
            client_fd,
            header,
            (size_t)taille
        );
    }
}


// ============================================================
// ENVOYER JSON
// ============================================================

void envoyer_json(
    int client_fd,
    const char *json
)
{
    envoyer_headers(
        client_fd,
        "200 OK",
        "application/json; charset=utf-8",
        strlen(json)
    );

    envoyer_tout(
        client_fd,
        json,
        strlen(json)
    );
}


// ============================================================
// ENVOYER ERREUR JSON
// ============================================================

void envoyer_erreur_json(
    int client_fd,
    const char *status,
    const char *message
)
{
    char json[1024];

    snprintf(
        json,
        sizeof(json),
        "{"
            "\"success\":false,"
            "\"message\":\"%s\""
        "}",
        message
    );

    envoyer_headers(
        client_fd,
        status,
        "application/json; charset=utf-8",
        strlen(json)
    );

    envoyer_tout(
        client_fd,
        json,
        strlen(json)
    );
}


// ============================================================
// LECTURE D'UN FICHIER
// ============================================================

char *lire_fichier(
    const char *chemin,
    size_t *taille
)
{
    FILE *fichier = fopen(
        chemin,
        "rb"
    );

    if (fichier == NULL)
    {
        printf(
            "[ERREUR] Fichier introuvable : %s\n",
            chemin
        );

        return NULL;
    }


    if (fseek(fichier, 0, SEEK_END) != 0)
    {
        fclose(fichier);
        return NULL;
    }


    long longueur = ftell(fichier);

    if (longueur < 0)
    {
        fclose(fichier);
        return NULL;
    }


    rewind(fichier);


    char *contenu = malloc(
        (size_t)longueur + 1
    );

    if (contenu == NULL)
    {
        fclose(fichier);
        return NULL;
    }


    size_t lu = fread(
        contenu,
        1,
        (size_t)longueur,
        fichier
    );


    contenu[lu] = '\0';

    fclose(fichier);

    *taille = lu;

    return contenu;
}


// ============================================================
// ENVOYER UN FICHIER AU NAVIGATEUR
// ============================================================

void envoyer_fichier(
    int client_fd,
    const char *chemin,
    const char *content_type
)
{
    size_t taille = 0;

    char *contenu = lire_fichier(
        chemin,
        &taille
    );


    if (contenu == NULL)
    {
        const char *erreur =
            "404 - Fichier introuvable";

        envoyer_headers(
            client_fd,
            "404 Not Found",
            "text/plain; charset=utf-8",
            strlen(erreur)
        );

        envoyer_tout(
            client_fd,
            erreur,
            strlen(erreur)
        );

        return;
    }


    envoyer_headers(
        client_fd,
        "200 OK",
        content_type,
        taille
    );


    envoyer_tout(
        client_fd,
        contenu,
        taille
    );


    free(contenu);
}


// ============================================================
// RECUPERER CONTENT-LENGTH
// ============================================================

size_t obtenir_content_length(
    const char *request
)
{
    const char *position = strstr(
        request,
        "Content-Length:"
    );

    if (position == NULL)
    {
        position = strstr(
            request,
            "content-length:"
        );
    }


    if (position == NULL)
    {
        return 0;
    }


    position = strchr(
        position,
        ':'
    );


    if (position == NULL)
    {
        return 0;
    }


    position++;


    while (
        *position == ' ' ||
        *position == '\t'
    )
    {
        position++;
    }


    return (size_t)strtoul(
        position,
        NULL,
        10
    );
}


// ============================================================
// TROUVER LE BODY HTTP
// ============================================================

char *trouver_body_http(
    char *request
)
{
    char *body = strstr(
        request,
        "\r\n\r\n"
    );


    if (body == NULL)
    {
        return NULL;
    }


    return body + 4;
}


// ============================================================
// ============================================================
// RECEPTION COMPLETE D'UNE REQUETE HTTP
// ============================================================
// ============================================================

ssize_t recevoir_requete_http(
    int client_fd,
    char *buffer,
    size_t taille_buffer
)
{
    size_t total = 0;

    size_t taille_headers = 0;

    size_t content_length = 0;

    int headers_trouves = 0;


    while (
        total < taille_buffer - 1
    )
    {
        ssize_t recu = recv(
            client_fd,
            buffer + total,
            taille_buffer - 1 - total,
            0
        );


        if (recu < 0)
        {
            perror("recv");
            return -1;
        }


        if (recu == 0)
        {
            break;
        }


        total += (size_t)recu;

        buffer[total] = '\0';


        // ----------------------------------------------------
        // Recherche fin des headers
        // ----------------------------------------------------

        if (!headers_trouves)
        {
            char *fin_headers = strstr(
                buffer,
                "\r\n\r\n"
            );


            if (fin_headers != NULL)
            {
                headers_trouves = 1;

                taille_headers =
                    (size_t)(
                        fin_headers - buffer
                    ) + 4;


                content_length =
                    obtenir_content_length(
                        buffer
                    );


                // GET sans body
                if (content_length == 0)
                {
                    break;
                }
            }
        }


        // ----------------------------------------------------
        // Si headers trouvés :
        // vérifier que tout le body est arrivé
        // ----------------------------------------------------

        if (headers_trouves)
        {
            size_t taille_totale_attendue =
                taille_headers +
                content_length;


            if (
                total >=
                taille_totale_attendue
            )
            {
                break;
            }
        }
    }


    buffer[total] = '\0';

    return (ssize_t)total;
}


// ============================================================
// ============================================================
// FRONT -> BACK
//
// POST /message
// ============================================================
// ============================================================

void recevoir_message_front(
    int client_fd,
    char *request
)
{
    char *body =
        trouver_body_http(
            request
        );


    if (
        body == NULL ||
        strlen(body) == 0
    )
    {
        printf(
            "[FRONT -> BACK] Body manquant\n"
        );


        envoyer_erreur_json(
            client_fd,
            "400 Bad Request",
            "Body JSON manquant"
        );


        return;
    }


    // ========================================================
    // AFFICHAGE DU MESSAGE RECU
    // ========================================================

    printf("\n");

    printf(
        "====================================================\n"
    );

    printf(
        "       MESSAGE RECU DEPUIS LE FRONT\n"
    );

    printf(
        "====================================================\n"
    );


    printf(
        "%s\n",
        body
    );


    printf(
        "====================================================\n"
    );


    // ========================================================
    // DETECTION BASIQUE
    // ========================================================

    char *debut = body;


    while (
        *debut == ' ' ||
        *debut == '\n' ||
        *debut == '\r' ||
        *debut == '\t'
    )
    {
        debut++;
    }


    if (*debut == '{')
    {
        printf(
            "[FRONT -> BACK] Type : OBJET JSON\n"
        );
    }

    else if (*debut == '[')
    {
        printf(
            "[FRONT -> BACK] Type : TABLEAU JSON\n"
        );
    }

    else
    {
        printf(
            "[FRONT -> BACK] Type : FORMAT INCONNU\n"
        );
    }


    // ========================================================
    // RECHERCHE DE QUELQUES TYPES DE MESSAGE
    //
    // Pour l'instant ce n'est PAS un vrai parseur JSON.
    // Cela permet simplement de voir ce qui arrive.
    // ========================================================

    if (
        strstr(
            body,
            "ConfigurationDef"
        ) != NULL
    )
    {
        printf(
            "[FRONT -> BACK] ConfigurationDef détectée\n"
        );
    }


    if (
        strstr(
            body,
            "ConfigurationMission"
        ) != NULL
    )
    {
        printf(
            "[FRONT -> BACK] ConfigurationMission détectée\n"
        );
    }


    if (
        strstr(
            body,
            "validation"
        ) != NULL ||
        strstr(
            body,
            "Validation"
        ) != NULL
    )
    {
        printf(
            "[FRONT -> BACK] Validation détectée\n"
        );
    }


    printf("\n");


    // ========================================================
    // REPONSE AU JAVASCRIPT
    // ========================================================

    const char *reponse =
        "{"
            "\"success\":true,"
            "\"message\":\"JSON recu par le serveur C\""
        "}";


    envoyer_json(
        client_fd,
        reponse
    );
}


